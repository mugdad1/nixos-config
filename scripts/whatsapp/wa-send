#!/usr/bin/env python3
"""Send one WhatsApp message through the bridge, log-first.

    wa-send <chat_jid> <message> <why> [mentions]

Every rule in here is Mugdad's, learned the hard way, not a style choice:

* the log line is written BEFORE the send, so a send that never happened is
  still visible and can be argued about afterwards (2026-09-30: the
  unaccounted sends, *"never have that incident back"*).
* the stop flag stops it. `~/.local/state/opencode/wa-stop` means the whole
  tree is down -- sends included, no loopholes.
* a `why` may not contain `|`: the log is pipe-delimited and a pipe in the
  reason shreds every column after it.
* if the bridge rejects the send, a `FAILED - (NOT SENT)` line is appended.
  2026-10-03: the wrapper sent `chat_jid` where the bridge wants `recipient`,
  so every send 400'd while the log line -- written first, by design -- claimed
  success. Both directions of that mismatch are caught now.
* every sent text is recorded in wa-sent-texts so the watcher can tell our own
  sends from his typing. Filtering `is_from_me` instead would blind the
  self-chat: it is the instruction channel, and every message he types there
  carries that flag.
* MUTE is a refusal, not a preference: 2026-10-16, "never watch, never read,
  never speak" -- hassan and mohannad. The watch half is enforced by their
  absence from the watcher's scope; this is the speaking half.
"""

import json
import os
import sys
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

STATE = Path(os.environ.get("WA_STATE", str(Path.home() / ".local/state/opencode")))
STOP = STATE / "wa-stop"
LOG = STATE / "wa-send-log.md"
SENT = STATE / "wa-sent-texts"
BRIDGE = Path(
    os.environ.get("WA_BRIDGE_DIR", str(Path.home() / "projects/whatsapp-mcp/whatsapp-bridge"))
)
API = "http://127.0.0.1:8080/api/send"

# 2026-10-16, his words: "never watch, never read, never speak" -- hassan and
# mohannad are out of BOTH scopes. The watcher drops them by omission; this is
# the speaking half: a mechanical refusal, so "never speak" survives me.
MUTE = frozenset(
    {
        "966506370279@s.whatsapp.net",  # hassan
        "966565541131@s.whatsapp.net",  # mohannad
    }
)

# THE SEND ALLOW-LIST -- a mechanical guard, added 2026-10-20 13:52.
#
# MUTE is a refusal, not a preference: 2026-10-16, "never watch, never read,
# never speak" -- hassan and mohannad. The watch half is enforced by their
# absence from the watcher's scope; this is the speaking half.
#
# This list is the same one, in the OTHER direction: the chats the agent may
# SPEAK to. His words, 2026-09-29: "only these ur allowed to do" / "only
# things i mentioned above" -- any chat not marked yes in the wiki's
# who-is-who table is public, relay only, never answered.
#
# Why it is enforced in code and not left to care: on 2026-10-20 an agent
# shell typed a mistyped JID (one digit off his own number) into wa-send and
# the bridge DELIVERED it -- "Message sent to 966551092452@s.whatsapp.net",
# resolved to a LID, out on the wire to a stranger who now has a message from
# his account. Nothing refused it: the watch scope did not apply to a send,
# and MUTE only covers two JIDs. A one-digit typo must not be able to reach
# a person who is not on the list, so the list is checked here, before the
# log line, before the request.
#
# Escape hatch, for the cases the list cannot know about: WA_ALLOW_ONCE=<jid>
# permits exactly that JID for exactly one invocation, and the send is
# logged like any other. The extended family group is NOT here -- his words
# "الاحفاد -- dont send anything there" -- so it needs that ticket.
ALLOW = frozenset(
    {
        "966551052452@s.whatsapp.net",  # self-chat -- the instruction channel
        "966554611442@s.whatsapp.net",  # mum
        "966503814854@s.whatsapp.net",  # dad
        "966503814854-1552717936@g.us",  # the family group (real JID: the old
        #  ...19936 was a typo -- that group does not exist; the WATCH list and
        #  messages.db both carry ...17936. The typo made every family-group
        #  send either refuse (guard) or fail at the bridge, and it is why the
        #  13:58 send came back "that group does not exist".)
        "966567433284@s.whatsapp.net",  # horaa
        "966505560448@s.whatsapp.net",  # zahraa
        "966506836216@s.whatsapp.net",  # kawthar
        "966508615596@s.whatsapp.net",  # abood
        # ahmed al-khalifa (966577647909) is on the watch scope but is NOT
        # here: he is not on the send list, so a reply to him needs the
        # WA_ALLOW_ONCE ticket, same as any chat off the list.
        #
        # hassan and mohannad are deliberately ABSENT even though they are on
        # the watch scope: MUTE refuses them ("never watch, never read, never
        # speak") and a send allow-list that named them would be a trap for
        # whoever edits this next. The MUTE check runs first and refuses them
        # regardless.
    }
)


def stamp() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M")


def append(path: Path, text: str) -> None:
    """Append as bytes: the log has carried non-UTF-8 before, and a decode
    error on write is a send that happens with no record of it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "ab") as fh:
        fh.write(text.encode("utf-8", "surrogateescape"))


def main() -> int:
    if len(sys.argv) < 4:
        print(__doc__)
        return 2
    jid, message, why = sys.argv[1], sys.argv[2], sys.argv[3]
    mentions = [m for m in sys.argv[4].split(",") if m] if len(sys.argv) > 4 else []

    if STOP.exists():
        print(f"STOP flag present ({STOP}) -- refusing to send")
        return 1
    # ONE-TIME TICKET (2026-10-16, his explicit words: "Temp allow" /
    # "this is just 1 time ticket"): WA_MUTE_TEMP_ALLOW=<jid> lifts the
    # refusal for that exact JID for this single invocation only. The seal
    # below remains the mechanical default — with the variable unset (what
    # every future call meets) the refusal fires exactly as before. Hassan
    # has no ticket. مهند's ticket shows up in the send log like any other
    # send, and the log is the count.
    ticket = {j.strip() for j in os.environ.get("WA_MUTE_TEMP_ALLOW", "").split(",") if j.strip()}
    if jid in MUTE and jid not in ticket:
        print(f"{jid} is muted (his order 2026-10-16: never watch, never read, never speak) -- refusing")
        return 1
    if jid in MUTE and jid in ticket:
        print(f"ONE-TIME TICKET honored for {jid} (explicit allow 2026-10-16) -- one send")
    # The allow-list guard. Everything else about a send is a judgement; this
    # one is a brake on a typo reaching a stranger (see the note on ALLOW).
    once = {j.strip() for j in os.environ.get("WA_ALLOW_ONCE", "").split(",") if j.strip()}
    if jid not in ALLOW and jid not in once:
        print(
            f"{jid} is not on the send allow-list -- refusing "
            "(his order 2026-09-29: only these ur allowed to do). "
            "For a one-off to a chat off the list, set WA_ALLOW_ONCE=<jid>."
        )
        return 1
    if "|" in why:
        print("refusing: a why containing '|' shreds the pipe-delimited log")
        return 1

    flat = message.replace("\n", "\\n")
    append(LOG, f"{stamp()} | {jid} | {flat} | {why}\n")

    try:
        token = (BRIDGE / "store" / ".bridge-token").read_text().strip()
    except OSError as exc:
        append(LOG, f"FAILED - (NOT SENT) no bridge token: {exc}\n")
        print(f"no bridge token: {exc}")
        return 1

    payload = {"recipient": jid, "message": message}
    if mentions:
        payload["mentions"] = mentions
    req = urllib.request.Request(
        API,
        data=json.dumps(payload).encode(),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            reply = resp.read().decode(errors="replace")
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")[:200]
        append(LOG, f"FAILED - (NOT SENT) HTTP {exc.code} {body}\n")
        print(f"bridge rejected: HTTP {exc.code} {body}")
        return 1
    except Exception as exc:  # unreachable, timeout, refused
        append(LOG, f"FAILED - (NOT SENT) {exc}\n")
        print(f"bridge unreachable: {exc}")
        return 1

    append(SENT, json.dumps(message) + "\n")
    print(reply)
    return 0


if __name__ == "__main__":
    sys.exit(main())
